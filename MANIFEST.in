include README.md PREPROCESSING.md DATA_SOURCES.md
include LICENSE NOTICE.md CONTRIBUTING.md CITATION.cff
include requirements.txt pyproject.toml MANIFEST.in .gitignore
include config.example.json resource_paths.example.json
include data_manifest.json
recursive-include docs *.md
recursive-include environments *.txt *.md
recursive-include tools *.py
recursive-include preprocessing *.py *.cpp
recursive-include tests *.py
recursive-include .github *.yml *.yaml
recursive-include src/cellcanon *.py *.json *.cpp
global-exclude *.py[cod]
global-exclude __pycache__
